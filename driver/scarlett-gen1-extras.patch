+/*
+ * Registers on the mixer unit (0x3c), reached with bRequest = UAC2_CS_MEM.
+ * A control's own register is elem->idx_off, and elem->channels is its
+ * number of values. Used by the level meters, the front-panel status
+ * word, "Save To HW" and the monitor configuration.
+ */
+static int scarlett_mem_xfer(struct usb_mixer_elem_info *elem, int reg,
+			     bool in, unsigned char *buf, int len)
+{
+	struct snd_usb_audio *chip = elem->head.mixer->chip;
+	int wValue = (elem->control << 8) | reg;
+	int idx = snd_usb_ctrl_intf(elem->head.mixer->hostif) |
+		  (elem->head.id << 8);
+
+	return snd_usb_ctl_msg(chip->dev,
+			       in ? usb_rcvctrlpipe(chip->dev, 0) :
+				    usb_sndctrlpipe(chip->dev, 0),
+			       UAC2_CS_MEM,
+			       USB_RECIP_INTERFACE | USB_TYPE_CLASS |
+			       (in ? USB_DIR_IN : USB_DIR_OUT),
+			       wValue, idx, buf, len);
+}
+
+/*
+ * One-byte on/off control reached with bRequest = UAC2_CS_CUR:
+ * wValue = (elem->control << 8) | elem->idx_off on unit elem->head.id.
+ */
+static int scarlett_cur1_xfer(struct usb_mixer_elem_info *elem, bool in,
+			      unsigned char *buf)
+{
+	struct snd_usb_audio *chip = elem->head.mixer->chip;
+	int wValue = (elem->control << 8) | elem->idx_off;
+	int idx = snd_usb_ctrl_intf(elem->head.mixer->hostif) |
+		  (elem->head.id << 8);
+
+	return snd_usb_ctl_msg(chip->dev,
+			       in ? usb_rcvctrlpipe(chip->dev, 0) :
+				    usb_sndctrlpipe(chip->dev, 0),
+			       UAC2_CS_CUR,
+			       USB_RECIP_INTERFACE | USB_TYPE_CLASS |
+			       (in ? USB_DIR_IN : USB_DIR_OUT),
+			       wValue, idx, buf, 1);
+}
+
+static int scarlett_cur1_get(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned char buf = 0;
+	int err;
+
+	err = scarlett_cur1_xfer(elem, true, &buf);
+	if (err < 0)
+		return err;
+
+	ucontrol->value.integer.value[0] = !!buf;
+	return 0;
+}
+
+static int scarlett_cur1_put(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned char buf = !!ucontrol->value.integer.value[0];
+	int changed = elem->cache_val[0] != buf;
+	int err;
+
+	err = scarlett_cur1_xfer(elem, false, &buf);
+	if (err < 0)
+		return err;
+
+	elem->cache_val[0] = buf;
+	return changed;
+}
+
+/*
+ * Test: read a mixer gain the way the vendor software does, with control
+ * selector 1 (wValue = 0x0100 | cell) instead of the selector 0 this driver
+ * uses. Returns the raw signed 16-bit value (1/256 dB).
+ */
+static int scarlett_cs1_info(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = -32768;
+	uinfo->value.integer.max = 32767;
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int scarlett_cs1_get(struct snd_kcontrol *kctl,
+			    struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	struct snd_usb_audio *chip = elem->head.mixer->chip;
+	unsigned char buf[2] = {0, };
+	int idx = snd_usb_ctrl_intf(elem->head.mixer->hostif) |
+		  (elem->head.id << 8);
+	int err;
+
+	err = snd_usb_ctl_msg(chip->dev, usb_rcvctrlpipe(chip->dev, 0),
+			      UAC2_CS_CUR,
+			      USB_RECIP_INTERFACE | USB_TYPE_CLASS | USB_DIR_IN,
+			      (elem->control << 8) | elem->idx_off, idx, buf, 2);
+	if (err < 0)
+		return err;
+
+	ucontrol->value.integer.value[0] = (s16)(buf[0] | (buf[1] << 8));
+	return 0;
+}
+
+static const struct snd_kcontrol_new usb_scarlett_ctl_cs1 = {
+	.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+	.access = SNDRV_CTL_ELEM_ACCESS_READ | SNDRV_CTL_ELEM_ACCESS_VOLATILE,
+	.name = "",
+	.info = scarlett_cs1_info,
+	.get =  scarlett_cs1_get,
+};
