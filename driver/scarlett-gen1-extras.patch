+/* level meters: one little-endian 16-bit value per channel */
+static int scarlett_level_info(struct snd_kcontrol *kctl,
+			       struct snd_ctl_elem_info *uinfo)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = elem->channels;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 65535;
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int scarlett_level_get(struct snd_kcontrol *kctl,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned char buf[2 * MAX_CHANNELS] = {0, };
+	int i, err;
+
+	err = scarlett_mem_xfer(elem, elem->idx_off, true, buf, 2 * elem->channels);
+	if (err < 0)
+		return err;
+
+	for (i = 0; i < elem->channels; i++)
+		ucontrol->value.integer.value[i] =
+			buf[2 * i] | (buf[2 * i + 1] << 8);
+	return 0;
+}
+
+/* front-panel status: four bytes, returned as they are */
+static int scarlett_status_info(struct snd_kcontrol *kctl,
+				struct snd_ctl_elem_info *uinfo)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = elem->channels;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 255;
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int scarlett_status_get(struct snd_kcontrol *kctl,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned char buf[MAX_CHANNELS] = {0, };
+	int i, err;
+
+	err = scarlett_mem_xfer(elem, elem->idx_off, true, buf, elem->channels);
+	if (err < 0)
+		return err;
+
+	for (i = 0; i < elem->channels; i++)
+		ucontrol->value.integer.value[i] = buf[i];
+	return 0;
+}
+
+/* "Save To HW": writing 1 stores the current settings in the device */
+static int scarlett_save_get(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	ucontrol->value.integer.value[0] = 0;
+	return 0;
+}
+
+static int scarlett_save_put(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned char buf = 0xa5;
+	int err;
+
+	if (!ucontrol->value.integer.value[0])
+		return 0;
+
+	err = scarlett_mem_xfer(elem, elem->idx_off, false, &buf, 1);
+	return err < 0 ? err : 0;
+}
+
+/*
+ * Mute (register 0x05) and Dim (0x06): one byte, on/off. Their state is
+ * read from the front-panel status word in register 0x04, bytes 2 and 3.
+ */
+static int scarlett_hwsw_get(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned char buf[4] = {0, };
+	int err;
+
+	err = scarlett_mem_xfer(elem, 0x04, true, buf, sizeof(buf));
+	if (err < 0)
+		return err;
+
+	ucontrol->value.integer.value[0] = !!buf[elem->idx_off - 0x03];
+	elem->cache_val[0] = ucontrol->value.integer.value[0];
+	return 0;
+}
+
+static int scarlett_hwsw_put(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned char buf = !!ucontrol->value.integer.value[0];
+	int changed = elem->cache_val[0] != buf;
+	int err;
+
+	err = scarlett_mem_xfer(elem, elem->idx_off, false, &buf, 1);
+	if (err < 0)
+		return err;
+
+	elem->cache_val[0] = buf;
+	return changed;
+}
+
+/* output bit mask: bit n = analogue output n + 1, sent as 32-bit LE */
+static int scarlett_mask_info(struct snd_kcontrol *kctl,
+			      struct snd_ctl_elem_info *uinfo)
+{
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_INTEGER;
+	uinfo->count = 1;
+	uinfo->value.integer.min = 0;
+	uinfo->value.integer.max = 1023;
+	uinfo->value.integer.step = 1;
+	return 0;
+}
+
+static int scarlett_mask_get(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned char buf[4] = {0, };
+	int err;
+
+	err = scarlett_mem_xfer(elem, elem->idx_off, true, buf, sizeof(buf));
+	if (err < 0)
+		return err;
+
+	elem->cache_val[0] = (buf[0] | (buf[1] << 8)) & 1023;
+	ucontrol->value.integer.value[0] = elem->cache_val[0];
+	return 0;
+}
+
+static int scarlett_mask_put(struct snd_kcontrol *kctl,
+			     struct snd_ctl_elem_value *ucontrol)
+{
+	struct usb_mixer_elem_info *elem = kctl->private_data;
+	unsigned int mask = ucontrol->value.integer.value[0];
+	unsigned char buf[4];
+	int changed, err;
+
+	if (mask > 1023)
+		return -EINVAL;
+
+	buf[0] = mask & 0xff;
+	buf[1] = (mask >> 8) & 0xff;
+	buf[2] = 0;
+	buf[3] = 0;
+	changed = elem->cache_val[0] != mask;
+
+	err = scarlett_mem_xfer(elem, elem->idx_off, false, buf, 4);
+	if (err < 0)
+		return err;
+
+	elem->cache_val[0] = mask;
+	return changed;
+}
